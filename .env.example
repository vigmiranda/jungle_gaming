# Portas publicadas pelo Docker Compose no host.
# Ajuste apenas se a porta já estiver ocupada por outro projeto.
POSTGRES_HOST_PORT=5432
KEYCLOAK_HOST_PORT=8088
LOCALSTACK_HOST_PORT=4566
API_HOST_PORT=8080
API_A_HOST_PORT=8081
API_B_HOST_PORT=8082
API_C_HOST_PORT=8083
LB_HOST_PORT=8090

# Ambiente
APP_ENV=local
LOG_LEVEL=info

# HTTP
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s

# PostgreSQL
POSTGRES_DSN=postgres://wagering:wagering@localhost:5432/wagering?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=0
POSTGRES_CONNECT_TIMEOUT=5s

# AWS / LocalStack
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_INTEGRATION_QUEUE_URL=http://localhost:4566/000000000000/wagering-integration-events
SQS_CONSUMER_ENABLED=true
SQS_CONSUMER_NAME=wager-consumer
SQS_MAX_MESSAGES=5
SQS_WAIT_TIME=20s
SQS_VISIBILITY_TIMEOUT=30s
SQS_PUBLISHER_ENABLED=true
SQS_PUBLISHER_BATCH_SIZE=10
SQS_PUBLISHER_POLL_INTERVAL=1s
SQS_PUBLISHER_LEASE_TTL=30s
SQS_PUBLISHER_BACKOFF_BASE=1s
SQS_PUBLISHER_BACKOFF_MAX=1m
WAGER_ALLOWED_PROVIDERS=provider-a,provider-b

# Keycloak / OIDC
# OIDC_JWKS_URL é opcional: por padrão deriva do issuer. Só é necessário quando
# o `iss` do token usa um hostname que a aplicação não resolve (API em container
# e token obtido do host, por exemplo).
OIDC_ISSUER_URL=http://localhost:8088/realms/wagering
OIDC_AUDIENCE=wagering-api
OIDC_JWKS_REFRESH=5m

# Worker de referências pendentes (ADR-009)
PENDING_REFERENCE_ENABLED=true
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_TTL=5m
PENDING_REFERENCE_BACKOFF_BASE=1s
PENDING_REFERENCE_BACKOFF_MAX=30s
PENDING_REFERENCE_POLL_INTERVAL=1s
PENDING_REFERENCE_BATCH_SIZE=10
