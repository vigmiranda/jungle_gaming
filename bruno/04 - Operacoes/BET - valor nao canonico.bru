meta {
  name: BET - valor nao canonico
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/wagering/transactions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{providerToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{providerId}}:nao-canonico-{{$randomInt}}
  X-Correlation-Id: bruno-{{$randomUUID}}
}

body:json {
  {
    "providerId": "{{providerId}}",
    "externalTransactionId": "nao-canonico-001",
    "playerId": "{{playerId}}",
    "walletId": "{{walletId}}",
    "roundId": "{{roundId}}",
    "gameId": "{{gameId}}",
    "kind": "BET",
    "money": { "amount": "25.0", "currency": "BRL" }
  }
}

docs {
  Valor com escala diferente de duas casas.

  A política é estrita (ADR-021): `"25.0"` é rejeitado com `INVALID_AMOUNT`, não
  normalizado silenciosamente para `"25.00"`. Isso garante que o hash de
  idempotência seja idêntico entre HTTP e SQS por construção.

  Disponível a partir da etapa 5 do roadmap.
}
