meta {
  name: WIN
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/wagering/transactions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{providerToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{providerId}}:win-001
  X-Correlation-Id: bruno-{{$randomUUID}}
}

body:json {
  {
    "providerId": "{{providerId}}",
    "externalTransactionId": "win-001",
    "playerId": "{{playerId}}",
    "walletId": "{{walletId}}",
    "roundId": "{{roundId}}",
    "gameId": "{{gameId}}",
    "kind": "WIN",
    "money": { "amount": "40.00", "currency": "BRL" }
  }
}

docs {
  Prêmio: crédito que exige valor positivo. Pode referenciar uma aposta da mesma
  rodada com `referenceExternalTransactionId`.

  Disponível a partir da etapa 5 do roadmap.
}
