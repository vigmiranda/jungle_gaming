meta {
  name: BET - conflito de payload
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/wagering/transactions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{providerToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{providerId}}:{{externalTransactionId}}
  X-Correlation-Id: bruno-{{$randomUUID}}
}

body:json {
  {
    "providerId": "{{providerId}}",
    "externalTransactionId": "{{externalTransactionId}}",
    "playerId": "{{playerId}}",
    "walletId": "{{walletId}}",
    "roundId": "{{roundId}}",
    "gameId": "{{gameId}}",
    "kind": "BET",
    "money": { "amount": "99.00", "currency": "BRL" }
  }
}

docs {
  Mesma chave de idempotência com conteúdo diferente: deve responder 409.

  O hash canônico dos campos de negócio é o que diferencia replay de conflito.

  Disponível a partir da etapa 5 do roadmap.
}

assert {
  res.status: eq 409
}
